z i\u00e7in buraday\u0131z.\r\n\r\nM\u00fc\u015fterilerimizle kurdu\u011fumuz samimi ili\u015fki, lezzet ve kaliteye olan tutkumuz, 10 y\u0131ld\u0131r bizimle olan misafirlerimizin en b\u00fcy\u00fck motivasyonu oldu. Sahilde ge\u00e7irdi\u011finiz zaman\u0131 daha keyifli k\u0131lmak i\u00e7in her zaman g\u00fclery\u00fczle sizi kar\u015f\u0131lamaya haz\u0131r\u0131z.\r\n\r\nBizim i\u00e7in her bardak, bir deneyimdir; her ziyaret, bir an\u0131d\u0131r. Gelin, siz de bu deneyimin bir par\u00e7as\u0131 olun.\n    [haftaIci] =&gt; 08:00 - 21:30\n    [haftaSonu] =&gt; 09:00 - 19:00\n)\n<\/pre>","_ci_previous_url":"http:\/\/supervisor.localhost\/qrmenumonline\/panel\/product","id":"23","firma_id":"1","k_adi":"5541897255","k_sifre":"ebe60f0271454b237a83418ff1676849","ad":"ubeydullah ","soyad":"binary data","unvan":"binary data","yetki":"0"},"headers":{"Host":"supervisor.localhost","Connection":"keep-alive","Sec-Ch-Ua":"&quot;Chromium&quot;;v=&quot;146&quot;, &quot;Not-A.Brand&quot;;v=&quot;24&quot;, &quot;Google Chrome&quot;;v=&quot;146&quot;","Sec-Ch-Ua-Mobile":"?0","Sec-Ch-Ua-Platform":"&quot;Windows&quot;","Upgrade-Insecure-Requests":"1","User-Agent":"Mozilla\/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit\/537.36 (KHTML, like Gecko) Chrome\/146.0.0.0 Safari\/537.36","Accept":"text\/html,application\/xhtml+xml,application\/xml;q=0.9,image\/avif,image\/webp,image\/apng,*\/*;q=0.8,application\/signed-exchange;v=b3;q=0.7","Sec-Fetch-Site":"same-origin","Sec-Fetch-Mode":"navigate","Sec-Fetch-User":"?1","Sec-Fetch-Dest":"document","Referer":"http:\/\/supervisor.localhost\/qrmenumonline\/panel\/product","Accept-Encoding":"gzip, deflate, br, zstd","Accept-Language":"tr-TR,tr;q=0.9,en-US;q=0.8,en;q=0.7","Cookie":"ci_session=gtj2k0642ppo5vva79f3j1mhkbqcucfc"},"cookies":{"ci_session":"gtj2k0642ppo5vva79f3j1mhkbqcucfc"},"request":"HTTP\/1.1","response":{"statusCode":200,"reason":"OK","contentType":"text\/html; charset=UTF-8","headers":{"Cache-control":"no-store, max-age=0, no-c